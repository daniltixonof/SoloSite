---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import TgLink from '../components/TgLink.astro';
import {services} from '../data/site';
import {pricing, rub, from} from '../data/config';

const pricingFaq: [string, string][] = [
    ['Первый разговор платный?', 'Нет. Тридцать минут, чтобы разобрать задачу и понять, чем я могу помочь. Если нужен подробный разбор — это аудит, его объём и стоимость согласуем заранее.'],
    ['Почему нет цены «от 30 тысяч»?', 'Потому что за эти деньги получается демонстрация, а не работающая система. Проверка сбоев, передача и документация занимают столько же времени, сколько основная сборка, и без них система живёт до первой нештатной ситуации.'],
    ['Можно начать с небольшого этапа?', 'Да. Аудит или один процесс — нормальный первый шаг. Следующий этап обсуждаем по результату, а не по плану, составленному заранее.'],
    ['Почему нельзя назвать точную цену сразу?', 'Внешне похожие задачи отличаются связями, правилами и качеством исходных данных. После разбора фиксирую границы и итоговую оценку, чтобы вы сравнивали конкретный объём работы, а не обещание.'],
    ['Есть ли обязательные платежи сверху?', 'За работу платите по согласованному объёму. Внешние сервисы и модели оплачиваются на ваших аккаунтах по условиям провайдеров. Сопровождение подключается отдельно.']
  ];
---
<Layout
  title="Стоимость: аудит, AI-функции и автоматизация — SoloPreneur"
  description={`Типовой проект от ${rub(pricing.projectFrom)}. Аудит процессов — две недели с картой и сметой. Сопровождение от ${rub(pricing.supportFrom)} в месяц. Что входит и что оплачивается отдельно.`}
  breadcrumbs={[{name:'Стоимость',url:'/pricing/'}]}
  faq={pricingFaq}>

<section class="wrap page-hero">
  <span class="eyebrow">Стоимость</span>
  <h1>Типовой проект —<br/>от {rub(pricing.projectFrom)}.</h1>
  <p class="lead">Начать удобнее с аудита: две недели, карта процессов, расчёт эффекта и смета. Его стоимость вычитается из первого этапа, если продолжаем работу.</p>
</section>

<section class="wrap price-grid" aria-label="Стоимость услуг">
  {services.map(s => (
    <article class:list={['price-card', {featured: s.featuredInPricing}]}>
      <span class="eyebrow">{s.tag}</span>
      <h2>{s.short}</h2>
      <p class="price">{s.typical}</p>
      <p class="price-caption">{s.time}</p>
      <ul>{s.outcome.slice(0, 4).map(o => <li>{o}</li>)}</ul>
      <a class="button button-secondary" href={`/services/${s.slug}/`}>Что входит в работу <Icon size={18}/></a>
    </article>
  ))}
</section>

<section class="wrap section split-section">
  <div><span class="eyebrow">Как читать эти цифры</span><h2>Вилка зависит<br/>от устройства задачи.</h2></div>
  <div class="prose">
    <p>Нижняя граница — это один процесс, понятные источники данных и небольшой набор связей. Несколько ролей, сложные ветвления, перенос данных и нестандартные системы двигают оценку к верхней границе.</p>
    <p>В смете отдельно обозначаю проектирование, разработку, проверку и передачу. Если по ходу появляются новые пожелания, сначала согласуем изменение объёма и бюджета.</p>
    <p>{pricing.extras} Вы будете знать о них до запуска.</p>
  </div>
</section>

<section class="wrap content-section split-section">
  <h2>Сопровождение<br/>после запуска</h2>
  <div class="prose">
    <p>Слежу за сбоями, исправляю и дорабатываю по мере того, как меняется процесс.</p>
    <p><strong>{from(pricing.supportFrom)} в месяц.</strong> {pricing.supportNote}</p>
    <p>Развитие продукта и крупные новые функции оцениваются как отдельные этапы.</p>
    <div class="page-actions"><TgLink variant="text" label="Обсудить сопровождение" size={18}/></div>
  </div>
</section>

<section class="wrap section faq-section">
  <div><span class="eyebrow">Про деньги</span><h2>Что спрашивают<br/>до начала работы.</h2></div>
  <FAQ items={pricingFaq}/>
</section>

<CTA/>
</Layout>
