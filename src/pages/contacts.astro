---
import {u} from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import TgLink from '../components/TgLink.astro';
import {contact, analytics} from '../data/config';

const topics = [
  ['Чем занимаетесь', 'Продукт, аудитория, размер команды.'],
  ['Как процесс идёт сейчас', 'Какие сервисы используете и где работа делается руками.'],
  ['Что должно измениться', 'Какой результат нужен и есть ли ограничения по срокам.']
];
---
<Layout
  title="Контакты — обсудить AI-функции и автоматизацию — SoloPreneur"
  description="Напишите Данилу Тихонову в Telegram @Tikhonov_D. Первый разговор — 30 минут, бесплатно. Разберём процесс и определим, что автоматизировать первым."
  breadcrumbs={[{name:'Контакты',url:u('/contacts/')}]}>

<section class="wrap page-hero">
  <span class="eyebrow">Контакты</span>
  <h1>Начнём<br/>с разговора.</h1>
  <p class="lead">Не нужно заранее знать, какой бот или сервис вам нужен. Расскажите, что сейчас отнимает время, — разберёмся вместе.</p>
</section>

<section class="wrap contact-grid">
  <div class="contact-panel">
    <span class="eyebrow">Данил Тихонов · SoloPreneur</span>
    <h2>Я на связи в Telegram</h2>
    <a class="contact-handle" href={contact.telegram} target="_blank" rel="noopener noreferrer" data-goal={analytics.goal}>{contact.handle}<Icon size={26}/></a>
    <p>Работаю удалённо. Сам разбираю задачу, предлагаю решение и веду проект до передачи.</p>
    <TgLink label={contact.labelTelegram} icon="telegram" size={20}/>
    <p class="contact-sla">{contact.sla}</p>
  </div>
  <div>
    <span class="eyebrow">Чтобы быстрее перейти к делу</span>
    <h2 class="contact-subhead">О чём написать</h2>
    <div class="process-list">{topics.map(([title, text], i) => (
      <div class="process-item"><span class="process-number">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></div>
    ))}</div>
    <p class="inline-note">Хватит пары предложений. Детали уточним в разговоре.</p>
  </div>
</section>
</Layout>
