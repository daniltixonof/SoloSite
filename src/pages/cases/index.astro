---
import Layout from '../../layouts/Layout.astro';import CaseCard from '../../components/CaseCard.astro';import CTA from '../../components/CTA.astro';import {cases} from '../../data/cases';
const categories=['Все проекты',...new Set(cases.map(c=>c.category))];
---
<Layout title="Кейсы автоматизации, Telegram-ботов и AI — SoloPreneur" description="Портфолио SoloPreneur: автоматизация встреч, AI-ассистенты, Telegram-воронки, образовательные платформы и Mini Apps. Задачи, решения и устройство проектов." breadcrumbs={[{name:'Кейсы',url:'/cases/'}]}><section class="wrap page-hero"><span class="eyebrow">Портфолио</span><h1>От бизнес-задачи<br/>к работающей системе.</h1><p class="lead">Проекты на стыке автоматизации, AI и цифровых продуктов. В каждом — контекст, логика решения и то, что меняется в работе.</p></section><section class="wrap" style="padding-bottom:90px"><div class="filters" role="group" aria-label="Фильтр кейсов">{categories.map((category,i)=><button class="filter" data-filter={category} aria-pressed={i===0?'true':'false'}>{category}</button>)}</div><p class="case-count" aria-live="polite">Показано проектов: {cases.length}</p><div class="case-grid">{cases.map(item=><CaseCard item={item}/>)}</div></section><CTA/><script>
const filters=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
const cards=document.querySelectorAll<HTMLElement>('[data-category]');
function applyFilter(category:string,updateUrl=false){
 if(![...filters].some(b=>b.dataset.filter===category))category='Все проекты';
 filters.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===category)));
 let count=0;cards.forEach(card=>{const show=category==='Все проекты'||card.dataset.category===category;card.hidden=!show;if(show)count++;});
 const status=document.querySelector('.case-count');if(status)status.textContent=`Показано проектов: ${count}`;
 if(updateUrl){const url=new URL(location.href);if(category==='Все проекты')url.searchParams.delete('category');else url.searchParams.set('category',category);history.pushState({},'',url);}
}
filters.forEach(button=>button.addEventListener('click',()=>applyFilter(button.dataset.filter!,true)));
applyFilter(new URL(location.href).searchParams.get('category')||'Все проекты');
addEventListener('popstate',()=>applyFilter(new URL(location.href).searchParams.get('category')||'Все проекты'));
</script></Layout>
