---
import Layout from '../../layouts/Layout.astro';import CTA from '../../components/CTA.astro';import Icon from '../../components/Icon.astro';import {cases} from '../../data/cases';import {services} from '../../data/site';
export function getStaticPaths(){return cases.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item:c}=Astro.props;const service=services.find(s=>s.slug===c.service)!;const next=cases[(cases.findIndex(i=>i.slug===c.slug)+1)%cases.length];
---
<Layout title={`${c.title} — кейс SoloPreneur`} description={c.summary} breadcrumbs={[{name:'Кейсы',url:'/cases/'},{name:c.industry,url:`/cases/${c.slug}/`}]}><section class="wrap page-hero"><div class="case-tags"><span>{c.category}</span><span>{c.industry}</span></div><h1>{c.title}</h1><p class="lead">{c.summary}</p><div class="page-actions">{c.stack.map(s=><span class="pill">{s}</span>)}</div></section><div class="wrap"><div class="case-banner">{c.flow.map((label,i)=><>{i>0&&<span class="banner-arrow" aria-hidden="true">→</span>}<div class="banner-node">{label}</div></>)}</div><p class="case-banner-label">Упрощённая схема решения</p></div><section class="wrap content-section split-section"><h2>Задача</h2><div class="prose"><p>{c.problem}</p></div></section><section class="wrap content-section split-section"><h2>Как устроено<br/>решение</h2><div class="process-list">{c.solution.map((s,i)=><div class="process-item"><span class="process-number">0{i+1}</span><p>{s}</p></div>)}</div></section><section class="wrap content-section split-section"><h2>Что изменилось</h2><div class="result-box"><p>{c.result}</p></div></section><section class="wrap section"><div class="related-grid"><a class="related-card" href={`/services/${service.slug}/`}><span class="eyebrow">Для похожей задачи</span><h3>{service.title}</h3><p>Состав работ, этапы и стоимость.</p><span class="case-link">Перейти к услуге <Icon size={18}/></span></a><a class="related-card" href={`/cases/${next.slug}/`}><span class="eyebrow">Следующий проект</span><h3>{next.title}</h3><p>{next.summary}</p><span class="case-link">Смотреть кейс <Icon size={18}/></span></a></div></section><CTA/></Layout>
