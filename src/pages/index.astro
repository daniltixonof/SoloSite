---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProcessScheme from '../components/ProcessScheme.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import TgLink from '../components/TgLink.astro';
import Audience from '../components/Audience.astro';
import Stats from '../components/Stats.astro';
import Testimonials from '../components/Testimonials.astro';
import {services, generalFaq} from '../data/site';
import {contact} from '../data/config';
import {featuredCases} from '../data/cases';

const stack = ['n8n','Telegram','Claude','OpenAI','YandexGPT','GigaChat','Supabase','Google Sheets','CRM и любой API'];

const process = [
  ['Разбираю процесс','Показываете, как работа идёт сейчас. Считаю, сколько времени уходит и на чём теряется.'],
  ['Фиксирую план и смету','Состав, этапы и стоимость на бумаге. Вы видите, что получите на каждом шаге.'],
  ['Собираю и проверяю','Показываю промежуточный результат. Проверяю не только рабочие сценарии, но и сбои.'],
  ['Передаю управление','Исходники, доступы и инструкции — ваши. Дальше поддерживаю или передаю вашей команде.']
];
---
<Layout
  title="AI-функции и автоматизация для онлайн-школ и бизнеса — SoloPreneur"
  description="Проверка работ, ответы ученикам и родителям, заявки и документы — делает система. Проектирую и собираю AI-функции и автоматизацию на n8n. Первый результат за 3–6 недель.">

<section class="hero wrap">
  <div class="hero-copy">
    <span class="eyebrow hero-eyebrow">AI-функции и автоматизация процессов</span>
    <h1>Снимаю ручную работу<br/>с онлайн-школ<br/><span class="hero-last">и растущих команд.</span></h1>
    <p>Проверка работ, ответы ученикам и родителям, заявки<br class="desktop"/> и документы — делает система. Первый результат<br class="desktop"/> за 3–6 недель.</p>
    <div class="hero-actions">
      <TgLink/>
      <a class="text-link" href="/cases/">Смотреть кейсы <span>↓</span></a>
    </div>
    <p class="hero-sla">{contact.sla}</p>
  </div>
  <div class="hero-visual"><ProcessScheme/></div>
</section>

<div class="integration-strip"><div class="wrap">
  <span>Работаю с вашим стеком</span>
  <div class="integration-names">{stack.map(name => <span>{name}</span>)}</div>
  <p class="integration-note">Если доступ к зарубежным сервисам закрыт — собираю на российских моделях и своём сервере. Резервный провайдер закладываю сразу, чтобы система не встала из-за одного отключения.</p>
</div></div>

<Audience/>

<section class="section wrap" id="services">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Что я делаю</span>
      <h2>Четыре направления.<br/>Один ответственный.</h2>
    </div>
    <p>Разбираю задачу, собираю решение<br class="desktop"/> и остаюсь на связи после запуска.</p>
  </div>
  <div class="service-grid">{services.map(s => (
    <a class="service-card" href={`/services/${s.slug}/`}>
      <div class="service-card-top"><span class="service-icon"><Icon name={s.icon} size={29}/></span><Icon size={24}/></div>
      <h3>{s.short}</h3>
      <p>{s.tag}</p>
      <div class="service-card-bottom"><span>{s.time}</span><span>Подробнее</span></div>
    </a>
  ))}</div>
</section>

<section class="section case-section wrap">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Из практики</span>
      <h2>Три системы,<br/>которые работают сейчас.</h2>
    </div>
    <a class="text-link" href="/cases/">Все кейсы <Icon size={18}/></a>
  </div>
  <div class="featured-cases">{featuredCases.map((c, i) => (
    <a class:list={['feature-case', {'feature-large': i === 0}]} href={`/cases/${c.slug}/`}>
      <div class="feature-flow" aria-hidden="true">{c.flow.map((label, j) => (
        <>{j > 0 && <span class="feature-arrow">→</span>}<span class="feature-node">{label}</span></>
      ))}</div>
      <div class="case-info">
        <div class="case-tags"><span>{c.category}</span><span>{c.industry}</span></div>
        <h3>{c.title}</h3>
        <p>{c.summary}</p>
        <span class="case-link">Смотреть кейс <Icon size={19}/></span>
      </div>
    </a>
  ))}</div>
</section>

<section class="section wrap">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Чем могу подтвердить</span>
      <h2>Цифры и отзывы.</h2>
    </div>
    <p>Здесь пока пустые места — заполняю только тем,<br class="desktop"/> что клиент разрешил показывать.</p>
  </div>
  <Stats/>
  <div class="trust-quotes"><Testimonials/></div>
</section>

<section class="section approach-section"><div class="wrap approach-grid">
  <div>
    <span class="eyebrow">Лично отвечаю за результат</span>
    <h2>Один контакт.<br/>Весь путь<br/>до запуска.</h2>
    <p class="approach-intro">Инженерное образование, затем маркетинг, теперь автоматизация и AI. Считаю процесс как конструкцию: где нагрузка, где откажет, что делать, когда откажет.</p>
    <a class="text-link" href="/about/">Как я работаю <Icon size={18}/></a>
  </div>
  <div class="process-list">{process.map(([title, text], i) => (
    <div class="process-item"><span class="process-number">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></div>
  ))}</div>
</div></section>

<section class="section wrap faq-section">
  <div>
    <span class="eyebrow">До первого сообщения</span>
    <h2>По делу.<br/>И заранее.</h2>
    <p>Что обычно спрашивают<br/>перед началом работы.</p>
  </div>
  <FAQ items={generalFaq}/>
</section>

<CTA/>
</Layout>

<style>
.hero-sla{margin-top:22px;font-size:14px;color:var(--muted);max-width:430px}
.integration-note{grid-column:2;max-width:820px;margin:14px 0 0;font-size:14px;line-height:1.6;color:var(--muted)}
.trust-quotes{margin-top:14px}
.feature-flow{display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:26px 28px;border-bottom:1px solid var(--line)}
.feature-node{font-size:13px;color:var(--text);background:var(--surface-2);border:1px solid var(--line);border-radius:7px;padding:7px 12px}
.feature-arrow{color:var(--muted);font-size:13px}
@media(max-width:760px){
  .hero-sla{margin-top:18px;font-size:13px}
  .feature-flow{padding:20px 20px}
  .feature-node{font-size:12px;padding:6px 10px}
}
</style>
