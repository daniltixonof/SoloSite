---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import SystemScene from '../components/SystemScene.astro';import CTA from '../components/CTA.astro';import FAQ from '../components/FAQ.astro';import {services,generalFaq,site} from '../data/site';
---
<Layout title="Автоматизация бизнеса, Telegram-боты и AI — SoloPreneur" description="Автоматизация процессов, разработка Telegram-ботов, AI-ассистентов и Mini Apps. Кейсы, понятные этапы и стоимость. Работа напрямую с Данилом Тихоновым.">
<section class="hero wrap"><div class="hero-copy"><span class="eyebrow hero-eyebrow"><span class="tiny-cross">✳</span> Автоматизация для бизнеса</span><h1>Рутина —<br/>системе.<br/><span class="hero-last">Рост — вам.</span></h1><p>Соединяю ботов, AI и ваши сервисы,<br class="desktop"/> чтобы работа двигалась без ручного контроля<br class="desktop"/> на каждом шаге.</p><div class="hero-actions"><a class="button" href={site.telegram} target="_blank" rel="noopener noreferrer">Обсудить задачу <Icon size={19}/></a><a class="text-link" href="/cases/">Смотреть кейсы <span>↓</span></a></div></div><div class="hero-visual"><SystemScene/></div><div class="hero-bottom"><span>От одного процесса<br/>до целого продукта</span><span>Проектирование · Разработка · Запуск</span><a href="#services" aria-label="Перейти к услугам">↓</a></div></section>
<div class="integration-strip"><div class="wrap"><span>Работаю с вашим стеком</span><div class="integration-names"><span>✣ n8n</span><span>◈ Telegram</span><span>OpenAI</span><span>Notion</span><span>Google Sheets</span><span>CRM & API</span></div></div></div>
<section class="section wrap" id="services"><div class="section-heading"><div><span class="eyebrow">Четыре направления</span><h2>Меньше действий.<br/>Больше движения.</h2></div><p>Разбираюсь в вашей задаче и собираю<br class="desktop"/> решение, которое вписывается<br class="desktop"/> в уже работающий бизнес.</p></div><div class="service-grid">{services.map(s=><a class="service-card" href={`/services/${s.slug}/`}><div class="service-card-top"><span class="service-icon"><Icon name={s.icon} size={29}/></span><Icon size={24}/></div><h3>{s.short==='Автоматизация'?'Автоматизация и интеграции':s.short}</h3><p>{s.tag}. {s.slug==='automation-integrations'?'Связь между сервисами, данными и людьми.':s.slug==='chatbots-funnels'?'От первого касания до оплаты и доступа.':s.slug==='ai-assistants-rag'?'Поддержка и поиск по документам компании.':'Рабочая версия вашей идеи для первых пользователей.'}</p><div class="service-card-bottom"><span>от {s.price} ₽</span><span>{s.time}</span></div></a>)}</div></section>
<section class="section case-section wrap"><div class="section-heading"><div><span class="eyebrow">Из практики</span><h2>Задачи разные.<br/>Подход системный.</h2></div><a class="text-link" href="/cases/">Все кейсы <Icon size={18}/></a></div><div class="featured-cases"><a class="feature-case feature-large" href="/cases/meeting-to-tasks/"><div class="case-diagram meeting-diagram" aria-hidden="true"><div class="mini-window"><div class="window-top"><span>Встреча завершена</span><span>↗</span></div><div class="waveform">{Array.from({length:30},(_,i)=><i style={`--height:${[14,25,40,22,54,68,36,19,49,27][i%10]}px`}/>)}</div><span class="window-sub">Запись → Транскрипция → Задачи</span></div><div class="task-window"><span class="task-label">Notion / Задачи встречи</span><p><i>✓</i> Согласовать следующий этап</p><p><i>✓</i> Подготовить материалы</p><p><i>✓</i> Назначить ответственных</p></div><span class="diagram-caption">Схема решения</span></div><div class="case-info"><div class="case-tags"><span>Автоматизация</span><span>AI</span></div><h3>Встреча закончилась.<br/>Задачи уже в Notion.</h3><p>Запись Zoom превращается в расшифровку, резюме и список действий.</p><span class="case-link">Смотреть проект <Icon size={19}/></span></div></a><a class="feature-case" href="/cases/spain-tax-assistant/"><div class="case-diagram rag-diagram" aria-hidden="true"><div class="document-stack"><span>§</span><i></i><i></i><i></i></div><div class="answer-bubble"><span class="answer-star">✧</span><span>Ответ найден<br/><small>Источник в базе знаний</small></span></div><span class="diagram-caption">Схема решения</span></div><div class="case-info"><div class="case-tags"><span>AI-ассистент</span><span>RAG</span></div><h3>Сложные документы.<br/>Понятный диалог.</h3><p>Помощник по налоговому законодательству Испании с поиском по базе знаний.</p><span class="case-link">Смотреть проект <Icon size={19}/></span></div></a></div></section>
<section class="section approach-section"><div class="wrap approach-grid"><div><span class="eyebrow">Лично отвечаю за результат</span><h2>Один контакт.<br/>Весь путь<br/>до запуска.</h2><p class="approach-intro">Я Данил, основатель SoloPreneur. Проектирую решения на стыке бизнеса, AI и разработки. Начинаю с процесса и довожу до работающей системы.</p><a class="text-link" href="/contacts/">Познакомимся <Icon size={18}/></a></div><div class="process-list">{[['Разбираю задачу','Показываете, как устроена работа сейчас. Вместе определяем, что стоит автоматизировать в первую очередь.'],['Фиксирую план','Согласуем состав решения, этапы и стоимость. Вы понимаете, что получите на каждом шаге.'],['Собираю и проверяю','Разрабатываю, показываю промежуточный результат, проверяю рабочие и ошибочные сценарии.'],['Передаю управление','Исходники, доступы и инструкции остаются у вас. Обсуждаем поддержку и дальнейшее развитие.']].map(([title,text],i)=><div class="process-item"><span class="process-number">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></div>)}</div></div></section>
<section class="section wrap faq-section"><div><span class="eyebrow">До первого сообщения</span><h2>По делу.<br/>И заранее.</h2><p>Что обычно спрашивают<br/>перед началом работы.</p></div><FAQ items={generalFaq}/></section><CTA/>
</Layout>
