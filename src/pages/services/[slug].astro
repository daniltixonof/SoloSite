---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import TgLink from '../../components/TgLink.astro';
import {services} from '../../data/site';
import {cases} from '../../data/cases';
import {site, pricing} from '../../data/config';

export function getStaticPaths() {
  return services.map(item => ({params: {slug: item.slug}, props: {item}}));
}
const {item: s} = Astro.props;
const related = s.caseSlugs
  .map(slug => cases.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .slice(0, 2);
---
<Layout
  title={`${s.title} — SoloPreneur`}
  description={s.intro}
  breadcrumbs={[{name:'Услуги',url:'/services/'},{name:s.short,url:`/services/${s.slug}/`}]}
  schema={{
    '@type':'Service', name: s.title, description: s.intro,
    provider: {'@id': site.origin + '/#studio'},
    offers: {'@type':'AggregateOffer', lowPrice: s.priceFrom, priceCurrency:'RUB',
      description:'Начальная стоимость. Итоговая оценка фиксируется после разбора задачи.'}
  }}>

<section class="wrap page-hero" style="padding-top:0">
  <span class="eyebrow">{s.title}</span>
  <h1>{s.headline}</h1>
  <p class="lead">{s.intro}</p>
  <div class="page-actions"><TgLink/><a class="text-link" href="#includes">Что входит ↓</a></div>
  <div class="metric-grid">
    <div class="metric"><span>Типовой проект</span><strong>{s.typical}</strong></div>
    <div class="metric"><span>Срок</span><strong>{s.time}</strong></div>
    <div class="metric"><span>Отвечает за работу</span><strong>Один человек</strong></div>
  </div>
  <p class="inline-note">Окончательную оценку фиксирую после разбора задачи. {pricing.extras}</p>
</section>

<section class="wrap content-section split-section">
  <h2>Для кого</h2>
  <div><ul class="check-list">{s.audience.map(a => <li>{a}</li>)}</ul></div>
</section>

<section class="wrap content-section split-section">
  <h2>Что вы получите</h2>
  <div><ul class="check-list accent">{s.outcome.map(o => <li>{o}</li>)}</ul></div>
</section>

{s.packages && (
  <section class="wrap content-section">
    <h2 class="packages-title">Три варианта объёма</h2>
    <div class="packages">{s.packages.map(p => (
      <article class:list={['package', {featured: p.featured}]}>
        <h3>{p.name}</h3>
        <p class="package-price">{p.price}</p>
        <p class="package-time">{p.time}</p>
        <p class="package-fit">{p.fit}</p>
        <ul>{p.includes.map(i => <li>{i}</li>)}</ul>
      </article>
    ))}</div>
  </section>
)}

<section class="wrap content-section split-section" id="includes">
  <h2>Что входит</h2>
  <div>
    <ul class="check-list">{s.includes.map(i => <li>{i}</li>)}</ul>
    <div class="extra-box">
      <span>Оплачивается отдельно</span>
      <ul>{s.extra.map(e => <li>{e}</li>)}</ul>
    </div>
  </div>
</section>

<section class="wrap content-section split-section">
  <h2>Когда это<br/>имеет смысл</h2>
  <div><ul class="check-list">{s.tasks.map(t => <li>{t}</li>)}</ul></div>
</section>

<section class="wrap content-section split-section">
  <h2>От задачи<br/>до запуска</h2>
  <div class="process-list">{s.steps.map((step, i) => (
    <div class="process-item"><span class="process-number">0{i+1}</span><p>{step}</p></div>
  ))}</div>
</section>

{related.length > 0 && (
  <section class="wrap section" id="examples">
    <div class="section-heading">
      <div><span class="eyebrow">Уже в практике</span><h2>Как это выглядит<br/>в работе.</h2></div>
      <a class="text-link" href="/cases/">Все кейсы <Icon size={18}/></a>
    </div>
    <div class="related-grid">{related.map(c => (
      <a class="related-card" href={`/cases/${c.slug}/`}>
        <span class="eyebrow">{c.category}</span>
        <h3>{c.title}</h3>
        <p>{c.summary}</p>
        <span class="case-link">Смотреть кейс <Icon size={18}/></span>
      </a>
    ))}</div>
  </section>
)}

<section class="wrap section faq-section">
  <div><span class="eyebrow">Детали, которые важны</span><h2>Что спрашивают<br/>по этой задаче.</h2></div>
  <FAQ items={s.faq}/>
</section>

<CTA/>
</Layout>
