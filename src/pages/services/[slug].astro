---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import CTA from '../../components/CTA.astro';import FAQ from '../../components/FAQ.astro';import {services,site} from '../../data/site';import {cases} from '../../data/cases';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service:s}=Astro.props;const related=cases.filter(c=>c.service===s.slug).slice(0,2);
---
<Layout title={`${s.title} — от ${s.price} ₽ | SoloPreneur`} description={s.intro} breadcrumbs={[{name:'Услуги',url:'/services/'},{name:s.short,url:`/services/${s.slug}/`}]} schema={{'@type':'Service',name:s.title,description:s.intro,provider:{'@id':site.origin+'/#studio'},offers:{'@type':'Offer',price:s.price.replaceAll(' ',''),priceCurrency:'RUB',description:'Начальная стоимость. Итоговая оценка зависит от согласованного объёма.'}}}>
<section class="wrap page-hero"><span class="eyebrow">{s.title}</span><h1>{s.headline}</h1><p class="lead">{s.intro}</p><div class="page-actions"><a class="button" href={site.telegram} target="_blank" rel="noopener noreferrer">Обсудить задачу <Icon size={18}/></a><a class="text-link" href="#examples">Примеры проектов ↓</a></div><div class="metric-grid"><div class="metric"><span>Стартовый объём</span><strong>от {s.price} ₽</strong></div><div class="metric"><span>Типовой проект</span><strong>{s.typical}</strong></div><div class="metric"><span>Ориентир по срокам</span><strong>{s.time}</strong></div></div><p class="inline-note">Окончательную оценку фиксируем после разбора задачи. Подписки, API и инфраструктура оплачиваются отдельно, если нужны.</p></section>
<section class="wrap content-section split-section"><h2>Когда это<br/>имеет смысл</h2><ul class="check-list">{s.tasks.map(t=><li><Icon name="check" size={20}/>{t}</li>)}</ul></section>
<section class="wrap content-section split-section"><div><span class="eyebrow">Состав решения</span><h2>Что вы получите</h2></div><ul class="check-list">{s.deliverables.map(t=><li><Icon name="check" size={20}/>{t}</li>)}</ul></section>
<section class="wrap content-section split-section"><h2>От задачи<br/>до запуска</h2><div class="process-list">{s.steps.map((step,i)=><div class="process-item"><span class="process-number">0{i+1}</span><p>{step}</p></div>)}</div></section>
<section class="wrap section" id="examples"><div class="section-heading"><h2>Уже в практике</h2><a class="text-link" href="/cases/">Все кейсы <Icon size={18}/></a></div><div class="related-grid">{related.map(c=><a class="related-card" href={`/cases/${c.slug}/`}><span class="eyebrow">{c.industry}</span><h3>{c.title}</h3><p>{c.summary}</p><span class="case-link">Смотреть проект <Icon size={18}/></span></a>)}</div></section><section class="wrap faq-section section" style="padding-top:0"><h2>Детали,<br/>которые важны</h2><FAQ items={s.faq}/></section><CTA/>
</Layout>
