---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import {services} from '../../data/site';
import {pricing, rub} from '../../data/config';
---
<Layout
  title="Услуги: AI-функции и автоматизация — SoloPreneur"
  description={`Аудит процессов, AI-модуль для онлайн-школы, ассистент по документам, сквозные процессы, Telegram-боты и первая версия продукта. Типовой проект от ${rub(pricing.projectFrom)}.`}
  breadcrumbs={[{name:'Услуги',url:'/services/'}]}>

<section class="wrap page-hero">
  <span class="eyebrow">Услуги</span>
  <h1>Начать можно с малого.<br/>И сразу увидеть эффект.</h1>
  <p class="lead">Шесть направлений. Первое — аудит: две недели, карта процессов и смета, после которых понятно, что делать дальше. Остальные — работа по результату этого разбора.</p>
</section>

<section class="wrap service-rows">
  {services.map(s => (
    <a class:list={['service-row', {entry: s.kind === 'entry'}]} href={`/services/${s.slug}/`}>
      <div class="service-row-main">
        <span class="service-icon"><Icon name={s.icon} size={26}/></span>
        <div>
          <h2>{s.title}</h2>
          <p>{s.intro}</p>
        </div>
      </div>
      <div class="service-row-meta">
        <span class="service-price">{s.typical}</span>
        <span>{s.time}</span>
        <span class="case-link">Подробнее <Icon size={17}/></span>
      </div>
    </a>
  ))}
</section>

<section class="wrap section split-section">
  <div><span class="eyebrow">Как считается стоимость</span><h2>Цена зависит<br/>от устройства задачи.</h2></div>
  <div class="prose">
    <p>Типовой проект начинается от {rub(pricing.projectFrom)}. Несколько ролей, сложные ветвления, перенос данных и нестандартные системы увеличивают объём — итоговую оценку фиксирую после разбора задачи.</p>
    <p>{pricing.extras}</p>
  </div>
</section>

<CTA/>
</Layout>
