---
// Схема того, что покупают: слева входящая работа, в центре система, справа результат.
// Тот же визуальный язык, что у схемы решения на странице кейса.
const columns = [
  { eyebrow: 'Приходит', items: ['Работа ученика', 'Вопрос родителя', 'Заявка и документ'] },
  { eyebrow: 'Система делает', items: ['Читает и проверяет', 'Отвечает по вашим правилам', 'Записывает и передаёт'], main: true },
  { eyebrow: 'Вы получаете', items: ['Проверенную работу', 'Ответ за минуту', 'Задачу и отчёт'] }
];
---
<div class="scheme" role="img" aria-label="Схема работы: входящие работы, вопросы и заявки обрабатывает система — она проверяет, отвечает по вашим правилам и передаёт результат вам.">
  {columns.map((col, i) => (
    <>
      {i > 0 && <span class="scheme-arrow" aria-hidden="true"></span>}
      <div class:list={['scheme-col', {main: col.main}]}>
        <span class="scheme-eyebrow">{col.eyebrow}</span>
        <ul>{col.items.map(item => <li>{item}</li>)}</ul>
      </div>
    </>
  ))}
</div>
<p class="scheme-note">Работает на ваших данных и по вашим правилам. Спорное отдаёт человеку.</p>
<style>
.scheme{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:stretch;gap:0;border:1px solid var(--line);border-radius:18px;background:var(--surface);padding:10px}
.scheme-col{padding:22px 20px;border-radius:12px;min-width:0}
.scheme-col.main{background:var(--surface-2);border:1px solid #3a3d33}
.scheme-eyebrow{display:block;font-size:12px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
.scheme-col.main .scheme-eyebrow{color:var(--accent)}
.scheme-col ul{list-style:none;margin:0;padding:0;display:grid;gap:11px}
.scheme-col li{font-size:15px;line-height:1.35;color:var(--text);text-wrap:pretty}
.scheme-arrow{align-self:center;width:26px;height:1px;background:var(--line);position:relative;flex:none}
.scheme-arrow::after{content:'';position:absolute;right:0;top:-3px;width:7px;height:7px;border-top:1px solid var(--line);border-right:1px solid var(--line);transform:rotate(45deg)}
.scheme-note{margin:14px 2px 0;font-size:14px;color:var(--muted)}
@media(max-width:860px){
  .scheme{grid-template-columns:1fr;padding:8px}
  .scheme-col{padding:18px 16px}
  .scheme-arrow{width:1px;height:20px;margin:0 auto;justify-self:center}
  .scheme-arrow::after{right:-3px;top:auto;bottom:0;transform:rotate(135deg)}
}
</style>
